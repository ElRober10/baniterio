# Copia este fichero a .env (nunca se sube a git) y rellena los valores
# reales antes de levantar docker-compose.prod.yml en el VPS.

DATABASE_PASSWORD=cambia-esto-por-una-contrasena-fuerte

# Genera uno nuevo, no reutilices el de desarrollo:
#   openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-generado

# Dominio real del frontend (sin barra al final).
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# log = no envía nada (por defecto). smtp = correo real. fcm = push real.
MAIL_MODO=log
PUSH_MODO=log
PUSH_CREDENCIALES=
